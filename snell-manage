#!/bin/bash

set -euo pipefail

_detect_arch() {
    case "$(uname -m)" in
        x86_64)          echo "amd64" ;;
        aarch64|arm64)   echo "aarch64" ;;
        *)               die "Unsupported architecture: $(uname -m)" ;;
    esac
}
BINARY_URL="https://dl.nssurge.com/snell/snell-server-v5.0.1-linux-$(_detect_arch).zip"
BINARY_PATH="/usr/local/bin/snell-server"
CONFIG_DIR="/etc/snell/users"
SERVICE_TEMPLATE="/etc/systemd/system/snell@.service"
PORT_START=8388

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

die()  { echo -e "${RED}Error: $1${NC}" >&2; exit 1; }
info() { echo -e "${BLUE}$1${NC}"; }
ok()   { echo -e "${GREEN}$1${NC}"; }
warn() { echo -e "${YELLOW}$1${NC}"; }

check_root() {
    [[ $EUID -eq 0 ]] || die "This script must be run as root"
}

next_port() {
    local port=$PORT_START
    while true; do
        local in_use=false
        shopt -s nullglob
        local confs=("$CONFIG_DIR"/*.conf)
        shopt -u nullglob
        for conf in "${confs[@]}"; do
            grep -q "listen = 0.0.0.0:$port" "$conf" && in_use=true && break
        done
        $in_use || { echo "$port"; return; }
        ((port++))
    done
}

get_server_ip() {
    curl -fsSL --connect-timeout 5 https://api4.ipify.org 2>/dev/null || echo "YOUR_SERVER_IP"
}

surge_line() {
    local username="$1" port="$2" psk="$3"
    local ip
    ip=$(get_server_ip)
    echo "$username = snell, $ip, $port, psk=$psk, version=5"
}

# ── install ──────────────────────────────────────────────────────────────────

cmd_install() {
    check_root
    info "Downloading snell-server from $BINARY_URL ..."

    local tmp_dir
    tmp_dir=$(mktemp -d)
    trap "rm -rf $tmp_dir" EXIT

    curl -fL "$BINARY_URL" -o "$tmp_dir/snell.zip"
    unzip -q "$tmp_dir/snell.zip" -d "$tmp_dir"
    install -m 755 "$tmp_dir/snell-server" "$BINARY_PATH"

    mkdir -p "$CONFIG_DIR"

    cat > "$SERVICE_TEMPLATE" << 'EOF'
[Unit]
Description=Snell Proxy Server (%i)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/snell-server -c /etc/snell/users/%i.conf
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    ok "snell-server installed to $BINARY_PATH"
}

# ── add ───────────────────────────────────────────────────────────────────────

cmd_add() {
    check_root
    local username="${1:-}"
    local port="${2:-}"

    [[ -n "$username" ]] || die "Usage: snell-manage add <username> [port]"
    [[ "$username" =~ ^[a-zA-Z0-9_-]+$ ]] || die "Username may only contain letters, numbers, _ and -"
    [[ -f "$CONFIG_DIR/$username.conf" ]] && die "User '$username' already exists"
    [[ -x "$BINARY_PATH" ]] || die "snell-server not installed. Run: snell-manage install"

    if [[ -z "$port" ]]; then
        port=$(next_port)
    else
        [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || die "Invalid port: $port"
        shopt -s nullglob
        local existing_confs=("$CONFIG_DIR"/*.conf)
        shopt -u nullglob
        for conf in "${existing_confs[@]}"; do
            grep -q "listen = 0.0.0.0:$port" "$conf" && die "Port $port is already used by another user"
        done
    fi

    local psk
    psk=$(openssl rand -base64 24)

    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_DIR/$username.conf" << EOF
[snell-server]
listen = 0.0.0.0:$port
psk = $psk
obfs = off
EOF

    systemctl enable --now "snell@$username"

    ok "User '$username' created"
    echo ""
    printf "  %-6s %s\n" "Port:" "$port"
    printf "  %-6s %s\n" "PSK:" "$psk"
    echo ""
    info "Surge proxy line:"
    surge_line "$username" "$port" "$psk"
}

# ── delete ────────────────────────────────────────────────────────────────────

cmd_delete() {
    check_root
    local username="${1:-}"
    [[ -n "$username" ]] || die "Usage: snell-manage delete <username>"
    [[ -f "$CONFIG_DIR/$username.conf" ]] || die "User '$username' does not exist"

    local port
    port=$(_user_port "$username" 2>/dev/null || true)

    systemctl disable --now "snell@$username" 2>/dev/null || true
    [[ -n "$port" ]] && _acct_rm "$username" "$port" 2>/dev/null || true
    rm -f "$CONFIG_DIR/$username.conf"
    rm -f "$QUOTA_DIR/$username"
    ok "User '$username' deleted"
}

# ── list ──────────────────────────────────────────────────────────────────────

cmd_list() {
    check_root
    shopt -s nullglob
    local confs=("$CONFIG_DIR"/*.conf)
    shopt -u nullglob

    if [[ ${#confs[@]} -eq 0 ]]; then
        warn "No users found. Use 'snell-manage add <username>' to add one."
        return
    fi

    printf "%-20s %-6s %-36s %s\n" "USERNAME" "PORT" "PSK" "STATUS"
    printf '%0.s─' {1..72}; echo

    for conf in "${confs[@]}"; do
        local username port psk status color
        username=$(basename "$conf" .conf)
        port=$(grep "^listen" "$conf" | grep -oP ':\K\d+')
        psk=$(grep "^psk" "$conf" | awk '{print $3}')

        if systemctl is-active --quiet "snell@$username" 2>/dev/null; then
            status="running"; color=$GREEN
        else
            status="stopped"; color=$RED
        fi

        printf "%-20s %-6s %-36s " "$username" "$port" "$psk"
        echo -e "${color}${status}${NC}"
    done
}

# ── start / stop / restart ────────────────────────────────────────────────────

cmd_start() {
    check_root
    local username="${1:-}"
    [[ -n "$username" ]] || die "Usage: snell-manage start <username>"
    [[ -f "$CONFIG_DIR/$username.conf" ]] || die "User '$username' does not exist"
    systemctl start "snell@$username"
    ok "Started snell@$username"
}

cmd_stop() {
    check_root
    local username="${1:-}"
    [[ -n "$username" ]] || die "Usage: snell-manage stop <username>"
    [[ -f "$CONFIG_DIR/$username.conf" ]] || die "User '$username' does not exist"
    systemctl stop "snell@$username"
    ok "Stopped snell@$username"
}

cmd_restart() {
    check_root
    local username="${1:-}"
    [[ -n "$username" ]] || die "Usage: snell-manage restart <username>"
    [[ -f "$CONFIG_DIR/$username.conf" ]] || die "User '$username' does not exist"
    systemctl restart "snell@$username"
    ok "Restarted snell@$username"
}

# ── surge ─────────────────────────────────────────────────────────────────────

cmd_surge() {
    local username="${1:-}"

    if [[ -z "$username" ]]; then
        shopt -s nullglob
        local confs=("$CONFIG_DIR"/*.conf)
        shopt -u nullglob
        [[ ${#confs[@]} -gt 0 ]] || { warn "No users found."; return; }
        local ip
        ip=$(get_server_ip)
        for conf in "${confs[@]}"; do
            local u p psk
            u=$(basename "$conf" .conf)
            p=$(grep "^listen" "$conf" | grep -oP ':\K\d+')
            psk=$(grep "^psk" "$conf" | awk '{print $3}')
            echo "$u = snell, $ip, $p, psk=$psk, version=5"
        done
    else
        [[ -f "$CONFIG_DIR/$username.conf" ]] || die "User '$username' does not exist"
        local port psk
        port=$(grep "^listen" "$CONFIG_DIR/$username.conf" | grep -oP ':\K\d+')
        psk=$(grep "^psk" "$CONFIG_DIR/$username.conf" | awk '{print $3}')
        surge_line "$username" "$port" "$psk"
    fi
}

# ── keygen ────────────────────────────────────────────────────────────────────

TOKEN_FILE="/etc/snell/api_token"
PREFIX_FILE="/etc/snell/api_prefix"

cmd_keygen() {
    check_root
    mkdir -p /etc/snell

    local token prefix
    token=$(openssl rand -hex 32)
    prefix=$(openssl rand -hex 8)   # 16-char hex path segment

    echo "$token"  > "$TOKEN_FILE";  chmod 600 "$TOKEN_FILE"
    echo "$prefix" > "$PREFIX_FILE"; chmod 600 "$PREFIX_FILE"

    ok "API credentials generated"
    echo ""
    printf "  %-10s %s\n" "Prefix:"  "$prefix"
    printf "  %-10s %s\n" "Token:"   "$token"
    echo ""
    _print_api_info "$prefix" "$token"
    warn "Restart snell-api to apply the new prefix: systemctl restart snell-api"
}

cmd_keyshow() {
    check_root
    [[ -f "$TOKEN_FILE" ]]  || die "No credentials found. Run: snell-manage keygen"
    [[ -f "$PREFIX_FILE" ]] || die "No prefix found. Run: snell-manage keygen"
    local prefix token
    prefix=$(cat "$PREFIX_FILE")
    token=$(cat "$TOKEN_FILE")
    echo ""
    printf "  %-10s %s\n" "Prefix:"  "$prefix"
    printf "  %-10s %s\n" "Token:"   "$token"
    echo ""
    _print_api_info "$prefix" "$token"
}

_print_api_info() {
    local prefix="$1" token="$2"
    local port=2086
    local ip
    ip=$(curl -fsSL --connect-timeout 3 https://api4.ipify.org 2>/dev/null || echo "<server-ip>")
    info "Base URL:    http://$ip:$port/$prefix"
    info "Swagger UI:  http://$ip:$port/$prefix/docs"
    info "Auth header: Authorization: Bearer $token"
}

# ── api-install ───────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VENV_DIR="/opt/snell-api/venv"

cmd_api_install() {
    check_root
    info "Installing snell-manage to /usr/local/bin..."
    cp "$SCRIPT_DIR/snell-manage" /usr/local/bin/snell-manage
    chmod +x /usr/local/bin/snell-manage

    info "Creating Python virtualenv at $VENV_DIR..."
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install -q -r "$SCRIPT_DIR/requirements.txt"

    local service_src="$SCRIPT_DIR/snell-api.service"
    [[ -f "$service_src" ]] || die "snell-api.service not found in $SCRIPT_DIR"

    sed -e "s|WorkingDirectory=.*|WorkingDirectory=$SCRIPT_DIR|" \
        -e "s|ExecStart=uvicorn|ExecStart=$VENV_DIR/bin/uvicorn|" \
        "$service_src" > /etc/systemd/system/snell-api.service

    systemctl daemon-reload
    systemctl enable --now snell-api

    ok "snell-api service installed and started"
    echo ""
    if [[ -f "$TOKEN_FILE" && -f "$PREFIX_FILE" ]]; then
        cmd_keyshow
    else
        warn "No credentials yet — run: snell-manage keygen"
    fi
}

# ── quota ─────────────────────────────────────────────────────────────────────

QUOTA_DIR="/etc/snell/quota"

# Parse human-readable size to bytes: 100GB → 107374182400
_parse_size() {
    local input="${1^^}"        # uppercase
    input="${input%B}"          # strip trailing B: GB→G, TB→T …
    local num unit
    if [[ "$input" =~ ^([0-9]+)([TGMK]?)$ ]]; then
        num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
    else
        die "Invalid size: $1  (examples: 100GB  50G  1TB  512MB)"
    fi
    case "$unit" in
        T) echo $(( num * 1099511627776 )) ;;
        G) echo $(( num * 1073741824 ))    ;;
        M) echo $(( num * 1048576 ))       ;;
        K) echo $(( num * 1024 ))          ;;
        *) echo "$num" ;;
    esac
}

# Format unix timestamp to YYYY-MM-DD (0 → —)
_fmt_date() {
    local ts="${1:-0}"
    (( ts > 0 )) && date -d "@$ts" "+%Y-%m-%d" || echo "—"
}

# Compute next reset timestamp from a period string
_next_reset_ts() {
    case "$1" in
        monthly)   date -d "+1 month"  +%s ;;
        quarterly) date -d "+3 months" +%s ;;
        yearly)    date -d "+1 year"   +%s ;;
        *)         echo "0" ;;
    esac
}

# Format bytes to human-readable string
_fmt_bytes() {
    local b="${1:-0}"
    (( b == 0 )) && { echo "0 B"; return; }
    if   (( b >= 1099511627776 )); then awk "BEGIN{printf \"%.2f TB\", $b/1099511627776}"
    elif (( b >= 1073741824    )); then awk "BEGIN{printf \"%.2f GB\", $b/1073741824}"
    elif (( b >= 1048576       )); then awk "BEGIN{printf \"%.2f MB\", $b/1048576}"
    elif (( b >= 1024          )); then awk "BEGIN{printf \"%.2f KB\", $b/1024}"
    else echo "${b} B"
    fi
}

# Quota file helpers
_qget() { grep "^$2=" "$QUOTA_DIR/$1" 2>/dev/null | cut -d= -f2 || echo "0"; }
_qset() {
    local f="$QUOTA_DIR/$1"
    if grep -q "^$2=" "$f" 2>/dev/null; then sed -i "s|^$2=.*|$2=$3|" "$f"
    else echo "$2=$3" >> "$f"; fi
}

# Get snell port for a user
_user_port() {
    local conf="$CONFIG_DIR/$1.conf"
    [[ -f "$conf" ]] || return 1
    grep "^listen" "$conf" | grep -oP ':\K\d+'
}

# Ensure SNELL_ACCT chain is wired into INPUT + OUTPUT
_ensure_chain() {
    iptables -N SNELL_ACCT 2>/dev/null || true
    iptables -C INPUT  -j SNELL_ACCT 2>/dev/null || iptables -I INPUT  -j SNELL_ACCT
    iptables -C OUTPUT -j SNELL_ACCT 2>/dev/null || iptables -I OUTPUT -j SNELL_ACCT
}

# Add per-user counting rules (idempotent)
_acct_add() {
    local u="$1" port="$2"
    _ensure_chain
    iptables -C SNELL_ACCT -p tcp --dport "$port" -m comment --comment "snell-in:$u"  -j RETURN 2>/dev/null \
        || iptables -A SNELL_ACCT -p tcp --dport "$port" -m comment --comment "snell-in:$u"  -j RETURN
    iptables -C SNELL_ACCT -p tcp --sport "$port" -m comment --comment "snell-out:$u" -j RETURN 2>/dev/null \
        || iptables -A SNELL_ACCT -p tcp --sport "$port" -m comment --comment "snell-out:$u" -j RETURN
}

# Remove all iptables rules for a user (counting + drop)
_acct_rm() {
    local u="$1" port="$2"
    iptables -D SNELL_ACCT -p tcp --dport "$port" -m comment --comment "snell-in:$u"      -j RETURN 2>/dev/null || true
    iptables -D SNELL_ACCT -p tcp --sport "$port" -m comment --comment "snell-out:$u"     -j RETURN 2>/dev/null || true
    iptables -D SNELL_ACCT -p tcp --dport "$port" -m comment --comment "snell-drop-in:$u" -j DROP   2>/dev/null || true
    iptables -D SNELL_ACCT -p tcp --sport "$port" -m comment --comment "snell-drop-out:$u"-j DROP   2>/dev/null || true
}

# Read current byte counter for a comment tag
_acct_bytes() {
    iptables -nvxL SNELL_ACCT 2>/dev/null | awk -v c="$1" '$0 ~ c {print $2; exit}' || echo "0"
}

# Block a user: add DROP rules + stop service
_block_user() {
    local u="$1" port="$2"
    iptables -C SNELL_ACCT -p tcp --dport "$port" -m comment --comment "snell-drop-in:$u"  -j DROP 2>/dev/null \
        || iptables -I SNELL_ACCT -p tcp --dport "$port" -m comment --comment "snell-drop-in:$u"  -j DROP
    iptables -C SNELL_ACCT -p tcp --sport "$port" -m comment --comment "snell-drop-out:$u" -j DROP 2>/dev/null \
        || iptables -I SNELL_ACCT -p tcp --sport "$port" -m comment --comment "snell-drop-out:$u" -j DROP
    systemctl stop "snell@$u" 2>/dev/null || true
}

# Unblock a user: remove DROP rules + start service
_unblock_user() {
    local u="$1" port="$2"
    iptables -D SNELL_ACCT -p tcp --dport "$port" -m comment --comment "snell-drop-in:$u"  -j DROP 2>/dev/null || true
    iptables -D SNELL_ACCT -p tcp --sport "$port" -m comment --comment "snell-drop-out:$u" -j DROP 2>/dev/null || true
    systemctl start "snell@$u" 2>/dev/null || true
}

# Compute expiry timestamp from a plan name
_expiry_from_plan() {
    case "$1" in
        monthly)   date -d "+1 month"  +%s ;;
        quarterly) date -d "+3 months" +%s ;;
        yearly)    date -d "+1 year"   +%s ;;
        *) die "plan must be: monthly  quarterly  yearly" ;;
    esac
}

cmd_quota() {
    check_root
    case "${2:-}" in
        set)     _quota_set_cmd    "${3:-}" "${4:-}" "${5:-}" ;;
        renew)   _quota_renew_cmd  "${3:-}" "${4:-}" ;;
        show)    _quota_show_cmd   "${3:-}" ;;
        reset)   _quota_reset_cmd  "${3:-}" ;;
        rm)      _quota_rm_cmd     "${3:-}" ;;
        sync)    _quota_sync_cmd ;;
        install) _quota_install_cmd ;;
        *)
            cat << 'EOF'
Usage: snell-manage quota <subcommand>

  set <user> <limit/mo> <plan>   Create quota: monthly limit + subscription plan
                                 limit : 100GB  50G  1TB  512MB
                                 plan  : monthly  quarterly  yearly
  renew <user> [plan]            Extend subscription (keeps current plan if omitted)
  show [user]                    Show usage + expiry table
  reset <user>                   Manually reset this month's traffic counter
  rm <user>                      Remove quota tracking for user
  sync                           Collect iptables counters (run by timer)
  install                        Install systemd timer (auto-sync every 60 s)
EOF
        ;;
    esac
}

_quota_set_cmd() {
    local username="${1:-}" size="${2:-}" plan="${3:-}"
    [[ -n "$username" && -n "$size" && -n "$plan" ]] \
        || die "Usage: snell-manage quota set <user> <limit/mo> <monthly|quarterly|yearly>"
    [[ -f "$CONFIG_DIR/$username.conf" ]] || die "User '$username' does not exist"
    [[ "$plan" =~ ^(monthly|quarterly|yearly)$ ]] \
        || die "plan must be: monthly  quarterly  yearly"

    local limit port expire next_reset
    limit=$(_parse_size "$size")
    port=$(_user_port "$username")
    expire=$(_expiry_from_plan "$plan")
    next_reset=$(date -d "+1 month" +%s)

    mkdir -p "$QUOTA_DIR"
    printf "limit=%s\nused=0\nblocked=0\nblock_reason=\nlast_in=0\nlast_out=0\nplan=%s\nexpire=%s\nnext_reset=%s\n" \
        "$limit" "$plan" "$expire" "$next_reset" > "$QUOTA_DIR/$username"

    _acct_add "$username" "$port"

    ok "Quota set: $username"
    printf "  %-14s %s / month\n" "Traffic:"  "$(_fmt_bytes "$limit")"
    printf "  %-14s %s\n"         "Plan:"     "$plan"
    printf "  %-14s %s\n"         "Expires:"  "$(_fmt_date "$expire")"
    printf "  %-14s %s\n"         "Next reset:" "$(_fmt_date "$next_reset")"
}

_quota_renew_cmd() {
    local username="${1:-}" plan="${2:-}"
    [[ -n "$username" ]] || die "Usage: snell-manage quota renew <user> [plan]"
    [[ -f "$QUOTA_DIR/$username" ]] || die "No quota set for '$username'"

    # Default to existing plan
    local current_plan
    current_plan=$(grep "^plan=" "$QUOTA_DIR/$username" | cut -d= -f2)
    plan="${plan:-$current_plan}"
    [[ "$plan" =~ ^(monthly|quarterly|yearly)$ ]] \
        || die "plan must be: monthly  quarterly  yearly"

    # Extend from current expiry if still in future, otherwise from now
    local now current_expire base new_expire
    now=$(date +%s)
    current_expire=$(_qget "$username" expire)
    (( current_expire > now )) && base=$current_expire || base=$now

    case "$plan" in
        monthly)   new_expire=$(date -d "@${base} +1 month"  +%s) ;;
        quarterly) new_expire=$(date -d "@${base} +3 months" +%s) ;;
        yearly)    new_expire=$(date -d "@${base} +1 year"   +%s) ;;
    esac

    _qset "$username" plan   "$plan"
    _qset "$username" expire "$new_expire"

    # Unblock if expired
    local reason
    reason=$(grep "^block_reason=" "$QUOTA_DIR/$username" 2>/dev/null | cut -d= -f2 || echo "")
    if [[ "$reason" == "expired" ]]; then
        local port
        port=$(_user_port "$username")
        _qset "$username" blocked "0"
        _qset "$username" block_reason ""
        _unblock_user "$username" "$port"
    fi

    ok "Renewed: $username"
    printf "  %-14s %s\n" "Plan:"    "$plan"
    printf "  %-14s %s\n" "Expires:" "$(_fmt_date "$new_expire")"
}

_quota_show_cmd() {
    local target="${1:-}"
    mkdir -p "$QUOTA_DIR"
    shopt -s nullglob; local qfiles=("$QUOTA_DIR"/*); shopt -u nullglob

    if [[ -n "$target" ]]; then
        [[ -f "$QUOTA_DIR/$target" ]] || die "No quota set for '$target'"
        qfiles=("$QUOTA_DIR/$target")
    fi

    if [[ ${#qfiles[@]} -eq 0 ]]; then
        warn "No quotas configured. Use: snell-manage quota set <user> <limit> <plan>"; return
    fi

    printf "%-16s %-10s %-10s %-8s %-11s %-12s %-12s %s\n" \
        "USER" "LIMIT/mo" "USED" "%" "PLAN" "NEXT RESET" "EXPIRES" "STATUS"
    printf '%0.s─' {1..95}; echo

    local now
    now=$(date +%s)

    for qfile in "${qfiles[@]}"; do
        local u limit used blocked plan expire next_reset block_reason remain pct status color
        u=$(basename "$qfile")
        limit=$(_qget "$u" limit)
        used=$(_qget "$u" used)
        blocked=$(_qget "$u" blocked)
        plan=$(grep "^plan=" "$QUOTA_DIR/$u" 2>/dev/null | cut -d= -f2 || echo "—")
        expire=$(_qget "$u" expire)
        next_reset=$(_qget "$u" next_reset)
        block_reason=$(grep "^block_reason=" "$QUOTA_DIR/$u" 2>/dev/null | cut -d= -f2 || echo "")
        pct=$(awk "BEGIN{printf \"%.1f\", ($limit>0 ? $used/$limit*100 : 0)}")

        if [[ "$blocked" == "1" && "$block_reason" == "expired" ]]; then
            status="expired"; color=$YELLOW
        elif [[ "$blocked" == "1" ]]; then
            status="quota"; color=$RED
        elif (( expire > 0 && expire - now < 604800 )); then   # < 7 days left
            status="expiring"; color=$YELLOW
        else
            status="active"; color=$GREEN
        fi

        printf "%-16s %-10s %-10s %-8s %-11s %-12s %-12s " \
            "$u" "$(_fmt_bytes "$limit")" "$(_fmt_bytes "$used")" "${pct}%" \
            "$plan" "$(_fmt_date "$next_reset")" "$(_fmt_date "$expire")"
        echo -e "${color}${status}${NC}"
    done
}

_quota_reset_cmd() {
    local username="${1:-}"
    [[ -n "$username" ]] || die "Usage: snell-manage quota reset <user>"
    [[ -f "$QUOTA_DIR/$username" ]] || die "No quota set for '$username'"

    local port
    port=$(_user_port "$username")

    _qset "$username" used         "0"
    _qset "$username" blocked      "0"
    _qset "$username" block_reason ""
    _qset "$username" last_in      "0"
    _qset "$username" last_out     "0"
    _qset "$username" next_reset   "$(date -d '+1 month' +%s)"

    _acct_rm "$username" "$port"
    _acct_add "$username" "$port"
    _unblock_user "$username" "$port"

    ok "Traffic reset for '$username' (next reset: $(_fmt_date "$(date -d '+1 month' +%s)"))"
}

_quota_rm_cmd() {
    local username="${1:-}"
    [[ -n "$username" ]] || die "Usage: snell-manage quota rm <user>"
    [[ -f "$QUOTA_DIR/$username" ]] || die "No quota set for '$username'"

    local port
    port=$(_user_port "$username" 2>/dev/null || echo "")
    [[ -n "$port" ]] && _acct_rm "$username" "$port"

    rm -f "$QUOTA_DIR/$username"
    ok "Quota removed for '$username'"
}

_quota_sync_cmd() {
    shopt -s nullglob; local qfiles=("$QUOTA_DIR"/*); shopt -u nullglob

    _ensure_chain

    # ── 0. Remove iptables rules for deleted users ────────────────────────────
    while IFS= read -r line; do
        local comment port_num direction user_tag
        comment=$(echo "$line" | grep -oP '\/\* snell-(in|out):\K[^ *]+')
        [[ -z "$comment" ]] && continue
        if [[ ! -f "$CONFIG_DIR/$comment.conf" ]]; then
            port_num=$(echo "$line" | grep -oP 'dpt:\K[0-9]+|spt:\K[0-9]+' | head -1)
            direction=$(echo "$line" | grep -oP 'snell-\K(in|out)(?=:)')
            [[ -z "$port_num" ]] && continue
            if [[ "$direction" == "in" ]]; then
                iptables -D SNELL_ACCT -p tcp --dport "$port_num" -m comment --comment "snell-in:$comment"  -j RETURN 2>/dev/null || true
                iptables -D SNELL_ACCT -p tcp --dport "$port_num" -m comment --comment "snell-drop-in:$comment"  -j DROP 2>/dev/null || true
            else
                iptables -D SNELL_ACCT -p tcp --sport "$port_num" -m comment --comment "snell-out:$comment" -j RETURN 2>/dev/null || true
                iptables -D SNELL_ACCT -p tcp --sport "$port_num" -m comment --comment "snell-drop-out:$comment" -j DROP 2>/dev/null || true
            fi
            info "[cleanup] removed orphan iptables rule for $comment"
        fi
    done < <(iptables -nvL SNELL_ACCT 2>/dev/null)

    [[ ${#qfiles[@]} -eq 0 ]] && return

    local now
    now=$(date +%s)

    for qfile in "${qfiles[@]}"; do
        local u limit used blocked last_in last_out port expire next_reset block_reason
        local cur_in cur_out delta new_used
        u=$(basename "$qfile")
        limit=$(_qget "$u" limit)
        used=$(_qget "$u" used)
        blocked=$(_qget "$u" blocked)
        last_in=$(_qget "$u" last_in)
        last_out=$(_qget "$u" last_out)
        expire=$(_qget "$u" expire)
        next_reset=$(_qget "$u" next_reset)
        block_reason=$(grep "^block_reason=" "$QUOTA_DIR/$u" 2>/dev/null | cut -d= -f2 || echo "")

        port=$(_user_port "$u" 2>/dev/null) || continue

        # ── 1. Check account expiry ───────────────────────────────────────────
        if (( expire > 0 && now >= expire )); then
            if [[ "$block_reason" != "expired" ]]; then
                _qset "$u" blocked "1"
                _qset "$u" block_reason "expired"
                _block_user "$u" "$port"
                warn "[$u] account expired ($(_fmt_date "$expire")) — blocked"
            else
                _acct_add "$u" "$port"   # re-apply after reboot
                _block_user "$u" "$port"
            fi
            continue
        fi

        # ── 2. Monthly traffic reset ──────────────────────────────────────────
        if (( next_reset > 0 && now >= next_reset )); then
            _acct_rm "$u" "$port"
            _acct_add "$u" "$port"

            # Unblock quota-blocked users on new month
            if [[ "$blocked" == "1" && "$block_reason" == "quota" ]]; then
                _unblock_user "$u" "$port"
                blocked=0; block_reason=""
            fi

            local new_next
            new_next=$(date -d "+1 month" +%s)
            _qset "$u" used         "0"
            _qset "$u" blocked      "$blocked"
            _qset "$u" block_reason "$block_reason"
            _qset "$u" last_in      "0"
            _qset "$u" last_out     "0"
            _qset "$u" next_reset   "$new_next"

            used=0; last_in=0; last_out=0
            info "[$u] monthly traffic reset — next: $(_fmt_date "$new_next")"
        fi

        # ── 3. Re-create iptables rules after reboot ──────────────────────────
        _acct_add "$u" "$port"
        [[ "$blocked" == "1" ]] && _block_user "$u" "$port"

        # ── 4. Collect traffic delta ──────────────────────────────────────────
        cur_in=$(_acct_bytes "snell-in:$u")
        cur_out=$(_acct_bytes "snell-out:$u")

        delta=$(( (cur_in  >= last_in  ? cur_in  - last_in  : cur_in)
                + (cur_out >= last_out ? cur_out - last_out : cur_out) ))

        new_used=$(( used + delta ))
        _qset "$u" used     "$new_used"
        _qset "$u" last_in  "$cur_in"
        _qset "$u" last_out "$cur_out"

        # ── 5. Enforce monthly quota ──────────────────────────────────────────
        if [[ "$blocked" != "1" ]] && (( new_used >= limit )); then
            _qset "$u" blocked "1"
            _qset "$u" block_reason "quota"
            _block_user "$u" "$port"
            warn "[$u] quota exceeded: $(_fmt_bytes "$new_used") / $(_fmt_bytes "$limit") — blocked"
        fi
    done
}

_quota_install_cmd() {
    local script_path
    script_path=$(realpath "${BASH_SOURCE[0]}")

    cat > /etc/systemd/system/snell-quota.service << EOF
[Unit]
Description=Snell quota sync (one-shot)

[Service]
Type=oneshot
ExecStart=$script_path quota sync
EOF

    cat > /etc/systemd/system/snell-quota.timer << 'EOF'
[Unit]
Description=Snell quota sync every 60 s

[Timer]
OnBootSec=60s
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
EOF

    systemctl daemon-reload
    systemctl enable --now snell-quota.timer
    ok "snell-quota.timer installed — syncs every 60 seconds"
}

# ── usage / dispatch ──────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: snell-manage <command> [args]

Snell instance commands:
  install              Download and install snell-server binary
  add <user> [port]    Add a new user (port auto-assigned if omitted)
  delete <user>        Stop and remove a user
  list                 List all users with port, PSK, and status
  start <user>         Start a user's snell instance
  stop <user>          Stop a user's snell instance
  restart <user>       Restart a user's snell instance
  surge [user]         Print Surge proxy line(s) for all or one user

API commands:
  keygen               Generate (or rotate) URL prefix + Bearer token
  keyshow              Print current prefix, token, and access URLs
  api-install          Install Python deps and start snell-api systemd service

Quota commands:
  quota set <u> <sz>   Set traffic quota (e.g. 100GB 50G 1TB 512MB)
  quota show [user]    Show usage table
  quota reset <user>   Reset counter and unblock user
  quota rm <user>      Remove quota for user
  quota sync           Manually sync iptables counters
  quota install        Install systemd timer (auto-sync every 60 s)
EOF
}

case "${1:-}" in
    install)     cmd_install ;;
    add)         cmd_add     "${2:-}" "${3:-}" ;;
    delete)      cmd_delete  "${2:-}" ;;
    list)        cmd_list ;;
    start)       cmd_start   "${2:-}" ;;
    stop)        cmd_stop    "${2:-}" ;;
    restart)     cmd_restart "${2:-}" ;;
    surge)       cmd_surge   "${2:-}" ;;
    keygen)      cmd_keygen ;;
    keyshow)     cmd_keyshow ;;
    api-install) cmd_api_install ;;
    quota)       cmd_quota   "$@" ;;
    *)           usage ;;
esac
